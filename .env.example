# ===================================================
# Konfigurasi Supabase Project
# Salin file ini menjadi .env.local lalu isi nilainya
# ===================================================

# 1. API Klien (untuk Frontend & Server SSR)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Database URI (untuk menjalankan `npm run db:migrate`)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# 3. URL publik situs
#    Dipakai untuk canonical, sitemap.xml, robots.txt, og:url, dan QR code.
#    WAJIB diisi saat deployment. Bila kosong, kode memakai fallback
#    https://portal-informasi-desa-fajar-baru.vercel.app
#
#    Saat domain resmi aktif, cukup ubah nilai ini ke https://fajarbaru.desa.id
#    lalu redeploy — tidak perlu menyentuh kode.
NEXT_PUBLIC_SITE_URL=https://portal-informasi-desa-fajar-baru.vercel.app

# 4. Token verifikasi Google Search Console (opsional)
#    Ambil dari Search Console > Settings > Ownership verification > HTML tag.
#    Cukup isi bagian `content="..."` tanpa tag HTML-nya.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Preview marker lokal; hanya aktif saat server berjalan dalam mode development.
LOCAL_MARKER_PREVIEW=false
